# ── Postgres ──────────────────────────────────────────────
DATABASE_URL=postgresql://cencori:cencori@localhost:5432/cencori
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Product Catalog ───────────────────────────────────────
ADMIN_TOKEN=changeme
ANNUAL_DISCOUNT_RATE=0.17
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_DEAD_LETTER_THRESHOLD=10
CACHE_TTL_SECONDS=3600
